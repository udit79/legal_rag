          "expected_outcome": "reject_wrong_type",
          "has_pdf_header": false,
          "strict_open": "error",
          "magic_bytes": "PNG"
        },
        {
          "file": "pdfs/10_corrupted/10g_encrypted_password_required.pdf",
          "description": "Valid 2-page PDF encrypted (AES-256) with a user password. Password for tests: fixture-pass.",
