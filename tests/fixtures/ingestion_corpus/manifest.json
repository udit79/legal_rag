          "has_eof_marker": true,
          "strict_open": "ok",
          "page_count": 3,
          "good_pages": [
            1,
            3
          ],
          "bad_pages": [
            2
          ],
          "good_page_tokens": {
            "1": "PAGE-1-OK",
            "3": "PAGE-3-OK"
          }
        }
      ],
      "pages": [],
      "expectations": [
        "No input may crash the worker or hang the queue; each yields a structured failure/quarantine record.",
        "10b is recoverable by rebuilding the xref table; 10a/10e should fail cleanly or recover partially.",
        "10c, 10d, 10f are rejected by magic-byte / size checks BEFORE any PDF parser runs.",
        "10g reports 'password required' (distinct from 'corrupt'); do not retry blindly.",
        "10h: document opens, but page 2 fails in isolation - pages 1 and 3 must still be ingested and the failure recorded against page 2 only."
      ]
    }
