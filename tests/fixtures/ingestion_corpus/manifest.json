          "expected_outcome": "reject_unparseable",
          "has_pdf_header": true,
          "has_eof_marker": false,
          "strict_open": "error"
        },
        {
          "file": "pdfs/10_corrupted/10f_png_renamed.pdf",
          "description": "A PNG image saved with a .pdf extension (magic bytes mismatch).",
