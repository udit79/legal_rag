          "sha256": "98f0be030bcd559be060a3d2b0b400647d3c035ccb5777ad0e4227f0c593ea85",
          "expected_outcome": "needs_password",
          "has_pdf_header": true,
          "has_eof_marker": true,
          "strict_open": "ok_but_encrypted",
          "password": "fixture-pass",
          "page_count_after_decrypt": 2,
          "deterministic": false
        },
        {
          "file": "pdfs/10_corrupted/10h_corrupt_page2_stream.pdf",
          "description": "Structurally valid 3-page PDF whose page-2 content stream is damaged. Pages 1 and 3 are fine.",
